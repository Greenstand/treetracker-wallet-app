{
  "ts-node": {
    "transpileOnly": true
  },
  "compilerOptions": {
    "types": ["node", "@wdio/globals/types"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@wdio/globals": ["node_modules/@wdio/globals/types"],
      "@treetracker/keycloak/*": ["../../packages/keycloak/*"],
      "@treetracker/wallet/*": ["../../packages/wallet/*"]
    }
  },
  "include": [
    "**/*.ts",
    ".wdio.conf.ts",
    "features/**/*.ts",
    "mocks/*.ts",
    "support/*.ts",
    "mocks/hooks"
  ],
  "exclude": ["node_modules"]
}
